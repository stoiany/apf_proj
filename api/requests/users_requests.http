@baseUrl = http://localhost:3000/api/v1
@demoUserId = 79937751-986b-4492-b86e-f7347a31b6ff

### GET all users
GET {{baseUrl}}/users?sortBy=username&sortDir=asc
X-Demo-UserId: {{demoUserId}}

### GET user by id
GET {{baseUrl}}/users/e971b1a1-845a-42b9-8b33-60e24fb2f529
X-Demo-UserId: {{demoUserId}}

### POST user
POST {{baseUrl}}/users/
X-Demo-UserId: {{demoUserId}}
Content-Type: application/json

{
  "username": "ae220k"
}

### PUT user
PUT {{baseUrl}}/users/e971b1a1-845a-42b9-8b33-60e24fb2f529
X-Demo-UserId: {{demoUserId}}
Content-Type: application/json

{
  "username": "Alex"
}

### DELETE user
DELETE {{baseUrl}}/users/e971b1a1-845a-42b9-8b33-60e24fb2f529
X-Demo-UserId: {{demoUserId}}